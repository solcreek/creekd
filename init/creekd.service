[Unit]
Description=creekd — multi-tenant process supervisor
Documentation=https://github.com/solcreek/creekd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/creekd
Restart=on-failure
RestartSec=5

# Identity. Stable UID required so /var/lib/creekd ownership
# survives daemon restarts and package upgrades. DynamicUser=no per
# DESIGN-self-host-state.md §"creekd privilege model & systemd
# hardening".
User=creekd
Group=creekd
DynamicUser=no

# Hardening — every directive below is required (not advisory).
# `creek host doctor` (lands with #23 CLI) reports
# `systemd_hardening_drift` if any are missing or weakened on the
# running host. Validator implementation: internal/hardening.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# Per-app UIDs need setpriv to call setresuid, setresgid, setgroups and
# capset in creekd's children. This single-line spelling is an allow-list
# (@system-service) and allows them — verified with systemd-run on
# Ubuntu 26.04. A deny-list line (SystemCallFilter=~@privileged) would
# block them and kill every app with SIGSYS: keep them allowed if you
# change this filter.
SystemCallFilter=@system-service ~@privileged ~@resources

# Capabilities. creekd binds 80/443 for ACME without full root;
# CAP_NET_BIND_SERVICE is the minimum that allows that.
# CAP_SETUID + CAP_SETGID let creekd run each app as its own UID
# (CREEKD_APP_UID_BASE). Without them every app runs as the creekd
# user, and a process can read /proc/<pid>/environ of any process with
# its own UID: every other app's secrets and creekd's CREEKD_ADMIN_TOKEN.
# Apps never inherit these two: setpriv clears the inheritable and
# ambient sets before exec'ing the app.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID

# No core dumps — protects in-memory secrets (#7 hostkey, future
# KEK envelope material) from landing on disk on crash.
LimitCORE=0
LimitNOFILE=65536

# Writable paths. ProtectSystem=strict makes the rest of the FS
# read-only; these two override.
ReadWritePaths=/var/lib/creekd /var/log/creekd

# State + logs
Environment=CREEKD_STATE_DIR=/var/lib/creekd/state
Environment=CREEKD_LOG_DIR=/var/lib/creekd/logs

# Admin API (loopback only by default)
Environment=CREEKD_ADMIN_ADDR=127.0.0.1:9080

# Dispatch proxy (public-facing, Caddy terminates TLS in front)
Environment=CREEKD_DISPATCH_ADDR=127.0.0.1:9000

# cgroup v2 isolation
Environment=CREEKD_CGROUP_PARENT=creekd.slice
Environment=CREEKD_DEFAULT_MEMORY_HIGH=256M
Environment=CREEKD_DEFAULT_MEMORY_MAX=1G

# Override via /etc/creekd/env if needed
EnvironmentFile=-/etc/creekd/env

[Install]
WantedBy=multi-user.target
